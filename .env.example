# Copy to .env and adjust. Fictional placeholders only — never put real bank
# details, passwords or WebDAV app passwords in this file or in git.

# Host address and port to publish on.
#   127.0.0.1      only this machine (use with tailscale serve / SSH tunnel)
#   192.168.1.20   the server's LAN IP: reachable from your intranet (recommended over 0.0.0.0)
# Never port-forward this to the internet. Note Docker-published ports bypass ufw/firewalld.
LOCUVI_BIND=127.0.0.1
LOCUVI_PORT=8000

# "password" (default): in-app sign-in using ./secrets/locuvi_password.txt
# "gateway": no in-app sign-in — ONLY behind an authenticated private gateway.
LOCUVI_AUTH_MODE=password

# true when served over HTTPS (e.g. tailscale serve). false for plain http (localhost or intranet).
COOKIE_SECURE=true

# Optional allowlist for a private Nextcloud (Tailscale/LAN), e.g.
#   WEBDAV_ALLOWED_PRIVATE_HOSTS=nextcloud.tailnet-example.ts.net,100.64.0.0/10
WEBDAV_ALLOWED_PRIVATE_HOSTS=
WEBDAV_ALLOW_HTTP_FOR_ALLOWLISTED=false

# Host directory where `locuvi backup` writes archives (mounted at /backups).
LOCUVI_BACKUP_DIR=./backups

LOG_LEVEL=INFO

# Image tag to run. "latest" follows main; pin e.g. LOCUVI_TAG=sha-1a2b3c4 to stay on (or go
# back to) one release. Tags: https://github.com/jc-universe87/locuvi/pkgs/container/gp-locum-manager
LOCUVI_TAG=latest
