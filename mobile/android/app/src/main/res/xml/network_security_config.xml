<?xml version="1.0" encoding="utf-8"?>
<!-- Locuvi runs on your own computer or server, usually reached as plain http on the home
     network or Tailscale, so plain http is allowed. Certificates for https are still checked. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
