# Copy to .env and adjust. Fictional placeholders only — never put real bank
# details, passwords or WebDAV app passwords in this file or in git.

# Host port, bound to 127.0.0.1 only.
LOCUVI_PORT=8000

# "password" (default): in-app sign-in using ./secrets/locuvi_password.txt
# "gateway": no in-app sign-in — ONLY behind an authenticated private gateway.
LOCUVI_AUTH_MODE=password

# true when served over HTTPS (recommended: tailscale serve). false for plain http on localhost.
COOKIE_SECURE=true

# Optional allowlist for a private Nextcloud (Tailscale/LAN), e.g.
#   WEBDAV_ALLOWED_PRIVATE_HOSTS=nextcloud.tailnet-example.ts.net,100.64.0.0/10
WEBDAV_ALLOWED_PRIVATE_HOSTS=
WEBDAV_ALLOW_HTTP_FOR_ALLOWLISTED=false

# Host directory where `locuvi backup` writes archives (mounted at /backups).
LOCUVI_BACKUP_DIR=./backups

LOG_LEVEL=INFO
